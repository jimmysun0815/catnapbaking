# ---------------------------------------------------------------
# 不太甜研究所 / Cat Nap — 环境变量
# 复制成 .env.local 再填。.env.local 不会进 git。
# 全部留空时网站跑演示数据，可以先看效果再接真服务。
# ---------------------------------------------------------------

# --- Supabase（必填，现在就要）-----------------------------------
# 在项目 Settings → API Keys 里拿。
# 2026 年起新项目给的是 publishable / secret，旧项目给的是 anon / service_role，
# 两种都支持，填对应的那一组即可。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# 浏览器端用，公开可见，受行级权限保护
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 旧项目用这个（二选一）
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# 服务端专用，绕过行级权限。泄露等于数据库裸奔，绝不能带 NEXT_PUBLIC_ 前缀
SUPABASE_SECRET_KEY=sb_secret_xxx
# 旧项目用这个（二选一）
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...


# --- Stripe ------------------------------------------------------
# 留空时结账走模拟支付页；一填上，模拟通道自动关闭。
# 沙盒用 sk_test_ 开头的密钥；生产建议用受限密钥（rk_ 开头），
# 只勾选 Checkout Sessions / Coupons 的写权限，泄露面更小。
STRIPE_SECRET_KEY=
# 本地调试：stripe listen --forward-to localhost:3000/api/webhooks/stripe
# 会打印一个 whsec_ 开头的密钥，填到这里。这个值和后台配置的端点不是同一个。
STRIPE_WEBHOOK_SECRET=
# 支付方式不在代码里配。微信支付和支付宝在 Stripe 后台
# Settings → Payment methods 里申请开通，批了就自动出现在结账页。


# --- Resend（可选，不填则收据邮件只打到控制台）---------------------
RESEND_API_KEY=
EMAIL_FROM="Cat Nap <orders@catnapbaking.ca>"
# 营销邮件的实体邮寄地址。CASL 要求商业邮件必须带，
# 不填则后台的群发功能会被拦住（宁可发不出去，也不发不合规的邮件）
MARKETING_FROM_ADDRESS=


# --- 其他 --------------------------------------------------------
# Vercel Cron 调用定时任务时带的密钥，本地开发可留空
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 站点模式 ---------------------------------------------------
# 真相源在数据库 site_settings，后台 /admin/settings 可实时切换。
# 这个变量只是兜底：数据库读不到时用它。不设时默认 live。
NEXT_PUBLIC_SITE_MODE=teaser
