# ---------------------------------------------------------------
# 不太甜研究所 / Cat Nap — 环境变量
# 复制成 .env.local 再填。.env.local 不会进 git。
# 全部留空时网站跑演示数据，可以先看效果再接真服务。
# ---------------------------------------------------------------

# --- Supabase（必填，现在就要）-----------------------------------
# 在项目 Settings → API Keys 里拿。
# 2026 年起新项目给的是 publishable / secret，旧项目给的是 anon / service_role，
# 两种都支持，填对应的那一组即可。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# 浏览器端用，公开可见，受行级权限保护
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 旧项目用这个（二选一）
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# 服务端专用，绕过行级权限。泄露等于数据库裸奔，绝不能带 NEXT_PUBLIC_ 前缀
SUPABASE_SECRET_KEY=sb_secret_xxx
# 旧项目用这个（二选一）
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...


# --- Stripe（先留空，公司注册开户后再填）--------------------------
# 留空时结账走模拟支付页；一填上，模拟通道自动关闭
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 微信支付和支付宝要在 Stripe 后台单独申请开通。
# 没批下来之前留空，结账页只显示信用卡
STRIPE_WALLETS=wechat_pay,alipay


# --- Resend（可选，不填则收据邮件只打到控制台）---------------------
RESEND_API_KEY=
EMAIL_FROM="Cat Nap <orders@catnapbaking.ca>"


# --- 其他 --------------------------------------------------------
# Vercel Cron 调用定时任务时带的密钥，本地开发可留空
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 站点模式 ---------------------------------------------------
# teaser  预热期：只讲产品，隐藏下单、库存、自取，页面底部收邮箱
# live    开业后：完整下单流程
# 开业当天改成 live 重新部署即可，代码不用动。不设时默认 live。
NEXT_PUBLIC_SITE_MODE=teaser
